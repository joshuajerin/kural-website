{
  "name": "kural-browser-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude tests/physics-directions.test.ts && npm run test:physics",
    "test:physics": "vitest run tests/physics-directions.test.ts",
    "test:worker": "node scripts/test_worker.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mujoco/mujoco": "3.11.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.3.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
